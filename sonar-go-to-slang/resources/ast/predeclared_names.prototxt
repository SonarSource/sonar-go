comments: {
  text: "// \"true\", \"false\" and \"nil\" are predeclared identifiers Go lets a program redeclare. Where they name something"
  content_text: " \"true\", \"false\" and \"nil\" are predeclared identifiers Go lets a program redeclare. Where they name something"
  range: "3:0::111"
  content_range: "3:2::111"
}
comments: {
  text: "// they are identifiers, and so is a read of a redeclared name; only a read of the predeclared value is a literal."
  content_text: " they are identifiers, and so is a read of a redeclared name; only a read of the predeclared value is a literal."
  range: "4:0::114"
  content_range: "4:2::114"
}
comments: {
  text: "// They live in their own file: declaring them at package scope would change the meaning of every case sharing it."
  content_text: " They live in their own file: declaring them at package scope would change the meaning of every case sharing it."
  range: "5:0::114"
  content_range: "5:2::114"
}
comments: {
  text: "// A grouped type specification is a class declaration of its own, like a single \"type X int\"; only its"
  content_text: " A grouped type specification is a class declaration of its own, like a single \"type X int\"; only its"
  range: "19:0::103"
  content_range: "19:2::103"
}
comments: {
  text: "// name goes through mapName."
  content_text: " name goes through mapName."
  range: "20:0::29"
  content_range: "20:2::29"
}
comments: {
  text: "// \"iota\" is an identifier wherever it appears, mapIdentImpl never mapped it to a literal. Declaring it"
  content_text: " \"iota\" is an identifier wherever it appears, mapIdentImpl never mapped it to a literal. Declaring it"
  range: "30:0::103"
  content_range: "30:2::103"
}
